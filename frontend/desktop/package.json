{
  "name": "shield-desktop",
  "version": "1.0.0",
  "description": "SHIELD — Intelligent Border Surveillance Platform (Desktop)",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "build": "electron-builder --win",
    "package": "electron-builder --win --dir"
  },
  "author": "SHIELD Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.shield.desktop",
    "productName": "SHIELD",
    "copyright": "Copyright © 2026 SHIELD Defense Systems",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "intrusion-reporter.js",
      "splash.html",
      "icon.ico",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../web_portal/dist",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "../../ai_engine",
        "to": "ai_engine",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "../../storage",
        "to": "storage",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHIELD"
    }
  }
}
