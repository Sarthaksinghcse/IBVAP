# ─── Supabase Intrusion Reporter Configuration ────────────────────────────────
# Set your project URL and public anon key from your Supabase Dashboard:
# Project Settings -> API

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: override default table name (defaults to "intrusions")
SUPABASE_INTRUSIONS_TABLE=intrusions
