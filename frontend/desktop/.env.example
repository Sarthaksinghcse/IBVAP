# ─── Shield / Supabase Realtime Intrusion Alerts Configuration ───────────────
# Enter your project URL and anon public key from your Supabase Dashboard:
# Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Target Table Name (defaults to 'alerts' matching Shield iOS app Realtime schema)
SUPABASE_ALERTS_TABLE=alerts
